#
# ros2_env --setup FILE [--cd DIR] hsm_generator|--ros-exec PACKAGE EXECUTABLE|COMMAND ARGS...

EXIT_USAGE=5
PLUGIN_DIR=$(dirname "$(readlink -f "$0")")

fail() {
    echo "ros2_env: $1" >&2
    exit $EXIT_USAGE
}

SETUP=
WORKDIR=
while [ $# -gt 0 ]; do
    case "$1" in
        --setup) [ $# -ge 2 ] || fail "--setup needs a file"; SETUP=$2; shift 2 ;;
        --cd) [ $# -ge 2 ] || fail "--cd needs a directory"; WORKDIR=$2; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || fail "no command"

# the setup scripts read unset variables, so they are sourced without set -u
if [ -n "$SETUP" ]; then
    [ -f "$SETUP" ] || fail "the ROS 2 setup $SETUP is not found; set it in the plugin settings"
    . "$SETUP" || fail "sourcing $SETUP failed"
fi
if [ -n "$WORKDIR" ]; then
    mkdir -p "$WORKDIR" && cd "$WORKDIR" || fail "cannot enter $WORKDIR"
    if [ -f install/setup.bash ]; then
        . install/setup.bash
    fi
fi

# the program replaces this shell: ros2 run would keep it as a child the editor's SIGTERM
# never reaches
ros_exec() {
    command -v ros2 > /dev/null || fail "ros2 is not found; check the ROS 2 setup"
    PREFIX=$(ros2 pkg prefix "$1" 2> /dev/null) || fail "the package $1 is not found; check the ROS 2 setup"
    [ -x "$PREFIX/lib/$1/$2" ] || fail "$2 is not found in the package $1"
    PROGRAM=$PREFIX/lib/$1/$2
    shift 2
    exec "$PROGRAM" "$@"
}

if [ "$1" = --ros-exec ]; then
    [ $# -ge 3 ] || fail "--ros-exec needs a package and an executable"
    shift
    ros_exec "$@"
fi
if [ "$1" = hsm_generator ]; then
    shift
    GENERATOR=${HSM_GENERATOR:-}
    if [ -z "$GENERATOR" ] && [ -f "$PLUGIN_DIR/../hsm_generator.py" ]; then
        GENERATOR=$PLUGIN_DIR/../hsm_generator.py
    fi
    if [ -z "$GENERATOR" ]; then
        ros_exec hsm_generator hsm_generator "$@"
    fi
    case "$GENERATOR" in
        *.py) exec python3 "$GENERATOR" "$@" ;;
        *) exec "$GENERATOR" "$@" ;;
    esac
fi
command -v "$1" > /dev/null || fail "$1 is not found; check the ROS 2 setup"
exec "$@"
