<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dRegion" for="graph" attr.name="region" attr.type="string"/>
  <key id="dSubmachineState" for="node" attr.name="submachineState" attr.type="string"/>
  <key id="dGeometry" for="graph" attr.name="geometry"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dGeometry" for="edge" attr.name="geometry"/>
  <key id="dSourcePoint" for="edge" attr.name="sourcePoint"/>
  <key id="dTargetPoint" for="edge" attr.name="targetPoint"/>
  <key id="dLabelGeometry" for="edge" attr.name="labelGeometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <key id="dPivot" for="edge" attr.name="pivot" attr.type="string"/>
  <key id="dChunk" for="edge" attr.name="chunk" attr.type="string"/>
  <key id="dCollapsed" for="node" attr.name="collapsed" attr.type="string"/>
  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dFormalName" for="graph" attr.name="formalName" attr.type="string"/>
  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">move_along_trajectory</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ move_along_trajectory

version/ 1.0.0

author/ Alexey Fedoseev

contact/ aleksey@fedoseev.net

license/ LGPL 3.0

platform/ HSM-ROS2

platformLanguage/ Python

transitionOrder/ actionFirst

eventPropagation/ block</data>
    </node>
    <node id="n0">
      <data key="dVertex">initial</data>
      <data key="dName"></data>
      <data key="dGeometry">
        <point x="638.291894" y="-17.719746"/>
      </data>
    </node>
    <node id="n2">
      <data key="dName">move_along_trajectory</data>
      <data key="dGeometry">
        <rect x="743.236486" y="-253.742192" width="654.939090" height="470.283446"/>
      </data>
      <graph id="n2:" edgedefault="directed">
        <node id="n2::n0">
          <data key="dName">follow_the_path</data>
          <data key="dData">entry/
Storage.load('path')
Debug.println('start')
</data>
          <data key="dGeometry">
            <rect x="25.579008" y="62.580741" width="614.360082" height="379.362666"/>
          </data>
          <graph id="n2::n0:" edgedefault="directed">
            <node id="n2::n0::n0">
              <data key="dName">follow_traj</data>
              <data key="dData">entry/
Navigation.move_along_traj(Storage.points('path'))

POINT_PASSED/
Debug.println('point passed')
</data>
              <data key="dGeometry">
                <rect x="26.617457" y="117.213541" width="208.380045" height="112.456329"/>
              </data>
            </node>
            <node id="n2::n0::n1">
              <data key="dName">complete</data>
              <data key="dData">entry/
Debug.println('finish')
</data>
              <data key="dGeometry">
                <rect x="425.980037" y="213.463541" width="173.380045" height="112.456329"/>
              </data>
            </node>
          </graph>
        </node>
      </graph>
    </node>
    <node id="n4">
      <data key="dVertex">final</data>
      <data key="dName"></data>
      <data key="dGeometry">
        <point x="1281.485554" y="263.882677"/>
      </data>
    </node>
    <node id="cDebug">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Debug</data>
      <data key="dData">type/ Debug</data>
    </node>
    <node id="cTimer">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer</data>
      <data key="dData">type/ Timer</data>
    </node>
    <node id="cNavigation">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Navigation</data>
      <data key="dData">type/ Navigation</data>
    </node>
    <node id="cStorage">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Storage</data>
      <data key="dData">type/ Storage</data>
    </node>
    <edge id="e0" source="n0" target="n2::n0::n0">
      <data key="dSourcePoint">
        <point x="0.000000" y="0.000000"/>
      </data>
      <data key="dTargetPoint">
        <point x="0.000000" y="56.228164"/>
      </data>
    </edge>
    <edge id="e1" source="n2::n0::n1" target="n4">
      <data key="dData">TIMER_TICK/</data>
      <data key="dSourcePoint">
        <point x="86.690022" y="112.456329"/>
      </data>
      <data key="dTargetPoint">
        <point x="0.000000" y="0.000000"/>
      </data>
      <data key="dLabelGeometry">
        <point x="91.356140" y="80.535773"/>
      </data>
    </edge>
    <edge id="n2::n0::e0" source="n2::n0::n0" target="n2::n0::n1">
      <data key="dData">MOVE_COMPLETED/</data>
      <data key="dGeometry">
        <point x="486.052603" y="56.228164"/>
      </data>
      <data key="dSourcePoint">
        <point x="208.380045" y="56.228164"/>
      </data>
      <data key="dTargetPoint">
        <point x="86.690022" y="0.000000"/>
      </data>
      <data key="dLabelGeometry">
        <point x="148.087758" y="30.299718"/>
      </data>
    </edge>
  </graph>
