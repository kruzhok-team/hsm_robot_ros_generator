            <node id="n2::n0::n0">
              <data key="dName">go_farward_0</data>
              <data key="dData">entry/
Wheels.forward(0.3)

exit/
Wheels.stop()
</data>
              <data key="dGeometry">
                <rect x="87.815587" y="133.636248" width="213.222130" height="144.403115"/>
              </data>
