                <node id="n2::n0::n1::n0">
                  <data key="dName">go_forward_1</data>
                  <data key="dData">entry/
Wheels.forward(0.3)
Timer.start(4.0)

exit/
Debug.println('right_turn exit')
</data>
                  <data key="dGeometry">
                    <rect x="384.404613" y="273.905247" width="179.740045" height="136.083115"/>
                  </data>
                </node>
                <node id="n2::n0::n1::n1">
                  <data key="dName">turn_right_1</data>
                  <data key="dData">entry/
Debug.println('right_turn entry')
Wheels.turn_right(math.pi/4)
Timer.start(5.0)

exit/
Wheels.stop()
</data>
                  <data key="dGeometry">
                    <rect x="47.441918" y="68.366889" width="228.380045" height="158.463559"/>
                  </data>
                </node>
                <node id="n2::n0::n1::n2">
