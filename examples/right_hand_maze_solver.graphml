            <node id="n2::n0::n2">
              <data key="dName">left_turn</data>
              <data key="dGeometry">
                <rect x="145.418803" y="431.434979" width="539.066675" height="484.538383"/>
              </data>
              <graph id="n2::n0::n2:" edgedefault="directed">
                <node id="n2::n0::n2::n0">
                  <data key="dName">turn_left_2</data>
                  <data key="dData">entry/
Debug.println('left_turn entry')
Wheels.turn_left(math.pi/4)
Timer.start(5.0)

exit/
Wheels.stop()
</data>
                  <data key="dGeometry">
                    <rect x="21.850895" y="299.187630" width="228.380045" height="168.403115"/>
                  </data>
