  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dFormalName" for="graph" attr.name="formalName" attr.type="string"/>
  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">turtle_square_wheels</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ turtle_square_wheels

version/ 1.0.0

author/ Alexey Fedoseev

contact/ aleksey@fedoseev.net

license/ LGPL 3.0

platform/ HSM-ROS2

platformLanguage/ Python

cyberiadaEditorView/ 1.30234 147 -342

geometry/ full

transitionOrder/ actionFirst

eventPropagation/ block</data>
    </node>
    <node id="n0">
      <data key="dVertex">initial</data>
      <data key="dName"></data>
      <data key="dGeometry">
        <point x="700.000000" y="0.000000"/>
      </data>
    </node>
    <node id="cDebug">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Debug</data>
      <data key="dData">type/ Debug</data>
    </node>
    <node id="cTimer">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer</data>
      <data key="dData">type/ Timer</data>
    </node>
    <node id="cWheels">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Wheels</data>
      <data key="dData">type/ Wheels</data>
    </node>
    <node id="n2::n0">
      <data key="dName">turtle_square_wheels</data>
      <data key="dGeometry">
        <rect x="750.000000" y="-125.000000" width="400.000000" height="425.000000"/>
      </data>
      <graph id="n2::n0:" edgedefault="directed">
        <node id="n2::n0::n0">
          <data key="dName">turn_right</data>
          <data key="dData">entry/
# PI/2 per 5 sec 
Wheels.turn_right((math.pi/2)/5)
Timer.start(5.0)

exit/
Wheels.stop()
</data>
          <data key="dGeometry">
            <rect x="25.000000" y="36.500000" width="350.000000" height="144.403115"/>
          </data>
        </node>
        <node id="n2::n0::n1">
          <data key="dName">go_ahead</data>
          <data key="dData">entry/
# 1 meter per sec
Wheels.forward(1.0)
Timer.start(4.0)

exit/
Wheels.stop()
</data>
          <data key="dGeometry">
            <rect x="25.000000" y="236.500000" width="350.000000" height="144.403115"/>
          </data>
        </node>
      </graph>
    </node>
    <edge id="n0-n2::n0::n0" source="n0" target="n2::n0::n0">
      <data key="dSourcePoint">
        <point x="0.000000" y="0.000000"/>
      </data>
      <data key="dTargetPoint">
        <point x="0.000000" y="75.000000"/>
      </data>
    </edge>
    <edge id="n2::n0::n0-n2::n0::n1" source="n2::n0::n0" target="n2::n0::n1">
      <data key="dData">TIMER_ELAPSED/</data>
      <data key="dSourcePoint">
        <point x="275.000000" y="144.403115"/>
      </data>
      <data key="dTargetPoint">
        <point x="275.000000" y="0.000000"/>
      </data>
      <data key="dLabelGeometry">
        <rect x="216.644744" y="157.504331" width="133.125000" height="27.000000"/>
      </data>
    </edge>
    <edge id="n2::n0::n1-n2::n0::n0" source="n2::n0::n1" target="n2::n0::n0">
      <data key="dData">TIMER_ELAPSED/</data>
      <data key="dSourcePoint">
        <point x="75.000000" y="0.000000"/>
      </data>
      <data key="dTargetPoint">
        <point x="75.000000" y="144.403115"/>
      </data>
      <data key="dLabelGeometry">
        <rect x="14.834312" y="-38.168624" width="133.125000" height="27.000000"/>
      </data>
    </edge>
  </graph>
