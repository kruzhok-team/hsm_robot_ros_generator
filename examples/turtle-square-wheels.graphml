  <key id="dFormalName" for="node" attr.name="formalName" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">turtle_square_wheels</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ turtle_square_wheels

version/ 1.0.0

author/ Alexey Fedoseev

contact/ aleksey@fedoseev.net

license/ LGPL 3.0

platform/ HSM-ROS2

platformLanguage/ Python

transitionOrder/ actionFirst

eventPropagation/ block</data>
    </node>
    <node id="n0">
      <data key="dVertex">initial</data>
      <data key="dName"></data>
      <data key="dGeometry">
        <point x="638.291894" y="-31.094811"/>
      </data>
    </node>
    <node id="n2">
      <data key="dName">turtle_square_wheels</data>
      <data key="dGeometry">
        <rect x="743.236486" y="-253.742192" width="677.422403" height="349.299874"/>
      </data>
      <graph id="n2:" edgedefault="directed">
        <node id="n2::n0">
          <data key="dName">go_by_square</data>
          <data key="dGeometry">
            <rect x="25.579008" y="62.580741" width="627.793961" height="258.379094"/>
          </data>
          <graph id="n2::n0:" edgedefault="directed">
            <node id="n2::n0::n0">
              <data key="dName">turn_right</data>
              <data key="dData">entry/
# PI/2 per 5 sec 
Wheels.turn_right((math.pi/2)/5)
Timer.start(5.0)

exit/
Wheels.stop()
</data>
              <data key="dGeometry">
                <rect x="26.617457" y="87.865083" width="213.222130" height="144.403115"/>
              </data>
            </node>
            <node id="n2::n0::n1">
              <data key="dName">go_ahead</data>
              <data key="dData">entry/
# 1 meter per sec
Wheels.forward(1.0)
Timer.start(4.0)

exit/
Wheels.stop()
</data>
              <data key="dGeometry">
                <rect x="377.230037" y="87.865083" width="228.380045" height="144.403115"/>
              </data>
            </node>
          </graph>
        </node>
      </graph>
    </node>
    <node id="cDebug">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Debug</data>
      <data key="dData">type/ Debug</data>
    </node>
    <node id="cTimer">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer</data>
      <data key="dData">type/ Timer</data>
    </node>
    <node id="cWheels">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Wheels</data>
      <data key="dData">type/ Wheels</data>
    </node>
    <edge id="e0" source="n0" target="n2::n0::n0">
      <data key="dSourcePoint">
        <point x="0.000000" y="0.000000"/>
      </data>
      <data key="dTargetPoint">
        <point x="0.000000" y="72.201558"/>
      </data>
    </edge>
    <edge id="n2::n0::e0" source="n2::n0::n0" target="n2::n0::n1">
      <data key="dData">TIMER_ELAPSED/</data>
      <data key="dSourcePoint">
        <point x="213.222130" y="35.796368"/>
      </data>
      <data key="dTargetPoint">
        <point x="0.000000" y="35.796368"/>
      </data>
      <data key="dLabelGeometry">
        <point x="131.122799" y="43.541445"/>
      </data>
    </edge>
    <edge id="n2::n0::e1" source="n2::n0::n1" target="n2::n0::n0">
      <data key="dData">TIMER_ELAPSED/</data>
      <data key="dSourcePoint">
        <point x="0.000000" y="107.046368"/>
      </data>
      <data key="dTargetPoint">
        <point x="213.222130" y="107.046368"/>
      </data>
      <data key="dLabelGeometry">
        <point x="-7.055719" y="114.311993"/>
      </data>
    </edge>
  </graph>
