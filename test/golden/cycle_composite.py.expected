import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Cycle_composite_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'cycle_composite_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            True,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("cycle_composite")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        Timer_tick_1s = "TIMER_TICK_1S"
        Timer_tick_1sEvent = pysm.Event(Timer_tick_1s)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent,
            "TIMER_TICK_1S": Timer_tick_1sEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_outer = pysm.StateMachine("outer")
        self.__sm.add_state(st_outer)
        st_outer_inside = pysm.State("outer_inside")
        st_outer.add_state(st_outer_inside, initial=True)
        st_outer_inside.handlers = {
            "enter": self.on_st_outer_inside_enter}
        st_outer_outside = pysm.State("outer_outside")
        st_outer.add_state(st_outer_outside)
        st_outer_outside.handlers = {
            "enter": self.on_st_outer_outside_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_outer, events=["INIT"])
        st_outer.add_transition(st_outer_inside, st_outer_outside, events=[Timer_tick])
        st_outer.add_transition(st_outer_outside, st_outer_inside, events=[Timer_tick_1s])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_outer_inside_enter(self, *_):
        Debug.println('inside')

    def on_st_outer_outside_enter(self, *_):
        Debug.println('outside')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Cycle_composite_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
