import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Cycle_ring_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'cycle_ring_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("cycle_ring")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_one = pysm.State("one")
        self.__sm.add_state(st_one)
        st_one.handlers = {
            "enter": self.on_st_one_enter}
        st_two = pysm.State("two")
        self.__sm.add_state(st_two)
        st_two.handlers = {
            "enter": self.on_st_two_enter}
        st_three = pysm.State("three")
        self.__sm.add_state(st_three)
        st_three.handlers = {
            "enter": self.on_st_three_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_one, events=["INIT"])
        self.__sm.add_transition(st_one, st_two, events=[Timer_tick])
        self.__sm.add_transition(st_two, st_three, events=[Timer_tick])
        self.__sm.add_transition(st_three, st_one, events=[Timer_tick])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_one_enter(self, *_):
        Debug.println('one')

    def on_st_two_enter(self, *_):
        Debug.println('two')

    def on_st_three_enter(self, *_):
        Debug.println('three')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Cycle_ring_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
