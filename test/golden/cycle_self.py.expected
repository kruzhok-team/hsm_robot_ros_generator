import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Cycle_self_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'cycle_self_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            False,
            True)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("cycle_self")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        Timer_tick_1m = "TIMER_TICK_1M"
        Timer_tick_1mEvent = pysm.Event(Timer_tick_1m)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent,
            "TIMER_TICK_1M": Timer_tick_1mEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_looping = pysm.State("looping")
        self.__sm.add_state(st_looping)
        st_looping.handlers = {
            "enter": self.on_st_looping_enter,
            "exit": self.on_st_looping_exit}
        st_done = pysm.State("done")
        self.__sm.add_state(st_done)
        st_done.handlers = {
            "enter": self.on_st_done_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_looping, events=["INIT"])
        self.__sm.add_transition(st_looping, st_looping, events=[Timer_tick])
        self.__sm.add_transition(st_looping, st_done, events=[Timer_tick_1m])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_looping_enter(self, *_):
        Debug.println('enter')

    def on_st_looping_exit(self, *_):
        Debug.println('leave')

    def on_st_done_enter(self, *_):
        Debug.println('done')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Cycle_self_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
