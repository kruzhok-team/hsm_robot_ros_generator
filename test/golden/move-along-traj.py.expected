import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.navigation_caller
import hsm_controller.storage_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Navigation = None
Storage = None
Wheels = None


class Move_along_trajectory_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'move_along_trajectory_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Navigation', 'Storage', 'Wheels'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Storage
        Storage = hsm_controller.storage_caller.Storage
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        self.__sm = pysm.StateMachine("move_along_trajectory")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        Move_completed = "MOVE_COMPLETED"
        Move_completedEvent = pysm.Event(Move_completed)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent,
            "MOVE_COMPLETED": Move_completedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_terminate = pysm.State("terminate")
        self.__sm.add_state(st_terminate)
        st_terminate.handlers = {"enter": self.terminate}
        st_move_along_trajectory = pysm.StateMachine("move_along_trajectory")
        self.__sm.add_state(st_move_along_trajectory)
        st_move_along_trajectory_follow_the_path = pysm.StateMachine("move_along_trajectory_follow_the_path")
        st_move_along_trajectory.add_state(st_move_along_trajectory_follow_the_path, initial=True)
        st_move_along_trajectory_follow_the_path.handlers = {
            "enter": self.on_st_move_along_trajectory_follow_the_path_enter}
        st_move_along_trajectory_follow_the_path_next_point = pysm.State(
            "move_along_trajectory_follow_the_path_next_point")
        st_move_along_trajectory_follow_the_path.add_state(
            st_move_along_trajectory_follow_the_path_next_point,
            initial=True)
        st_move_along_trajectory_follow_the_path_next_point.handlers = {
            "enter": self.on_st_move_along_trajectory_follow_the_path_next_point_enter}
        st_move_along_trajectory_follow_the_path_complete = pysm.State("move_along_trajectory_follow_the_path_complete")
        st_move_along_trajectory_follow_the_path.add_state(st_move_along_trajectory_follow_the_path_complete)
        st_move_along_trajectory_follow_the_path_complete.handlers = {
            "enter": self.on_st_move_along_trajectory_follow_the_path_complete_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_move_along_trajectory_follow_the_path_next_point, events=["INIT"])
        st_move_along_trajectory_follow_the_path.add_transition(
            st_move_along_trajectory_follow_the_path_complete,
            st_terminate,
            events=[Timer_tick])
        st_move_along_trajectory_follow_the_path.add_transition(
            st_move_along_trajectory_follow_the_path_next_point,
            st_move_along_trajectory_follow_the_path_complete,
            events=[Move_completed],
            condition=self.is_move_along_trajectory_follow_the_path_next_point_TO_complete_MOVE_COMPLETED)
        st_move_along_trajectory_follow_the_path.add_transition(
            st_move_along_trajectory_follow_the_path_next_point,
            st_move_along_trajectory_follow_the_path_next_point,
            events=[Move_completed],
            condition=self.is_move_along_trajectory_follow_the_path_next_point_TO_point_MOVE_COMPLETED)
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_move_along_trajectory_follow_the_path_enter(self, *_):
        Storage.load('path')
        Debug.println('start')

    def on_st_move_along_trajectory_follow_the_path_next_point_enter(self, *_):
        pnt = Storage.next('path')
        Navigation.move_to_point(*pnt)
        Debug.print('point:')
        Debug.println(str(pnt))

    def on_st_move_along_trajectory_follow_the_path_complete_enter(self, *_):
        Debug.println('finish')

    # Transition Conditions and Actions:

    def is_move_along_trajectory_follow_the_path_next_point_TO_complete_MOVE_COMPLETED(self, state, event):
        return (not Storage.has_data())

    def is_move_along_trajectory_follow_the_path_next_point_TO_point_MOVE_COMPLETED(self, state, event):
        return (Storage.has_data())

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Move_along_trajectory_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
