from rclpy.executors import ExternalShutdownException
import hsmd
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.navigation_caller
import hsm_controller.storage_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Navigation = None
Storage = None
Wheels = None
# the event being processed, set by the dispatcher
event = None


def on_st_move_along_trajectory_follow_the_path_enter():
    Storage.load('path')
    Debug.println('start')


def on_st_move_along_trajectory_follow_the_path_follow_traj_enter():
    Navigation.move_along_traj(Storage.points('path'))


def on_move_along_trajectory_follow_the_path_follow_traj_POINT_PASSED():
    Debug.println('point passed')


def on_st_move_along_trajectory_follow_the_path_complete_enter():
    Debug.println('finish')


machine = hsmd.Machine('move_along_trajectory', states=[
    hsmd.Initial(id='initial'),
    hsmd.Final(id='final'),
    hsmd.State('move_along_trajectory', states=[
        hsmd.Initial(id='move_along_trajectory.initial'),
        hsmd.State(
            'follow_the_path',
            id='move_along_trajectory_follow_the_path',
            entry=on_st_move_along_trajectory_follow_the_path_enter,
            states=[
                hsmd.Initial(id='move_along_trajectory_follow_the_path.initial'),
                hsmd.State(
                    'follow_traj',
                    id='move_along_trajectory_follow_the_path_follow_traj',
                    entry=on_st_move_along_trajectory_follow_the_path_follow_traj_enter,
                    internal=[
                        hsmd.On(
                            'POINT_PASSED',
                            action=on_move_along_trajectory_follow_the_path_follow_traj_POINT_PASSED),
                    ]),
                hsmd.State(
                    'complete',
                    id='move_along_trajectory_follow_the_path_complete',
                    entry=on_st_move_along_trajectory_follow_the_path_complete_enter),
            ]),
    ]),
], transitions=[
    hsmd.Transition('initial', 'move_along_trajectory_follow_the_path_follow_traj'),
    hsmd.Transition('move_along_trajectory.initial', 'move_along_trajectory_follow_the_path'),
    hsmd.Transition(
        'move_along_trajectory_follow_the_path.initial',
        'move_along_trajectory_follow_the_path_follow_traj'),
    hsmd.Transition('move_along_trajectory_follow_the_path_complete', 'final', 'TIMER_TICK'),
    hsmd.Transition(
        'move_along_trajectory_follow_the_path_follow_traj',
        'move_along_trajectory_follow_the_path_complete',
        'MOVE_COMPLETED'),
])


class Move_along_trajectory_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'move_along_trajectory_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Navigation', 'Storage', 'Wheels'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Storage
        Storage = hsm_controller.storage_caller.Storage
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        dispatcher = hsmd.Dispatcher(machine, namespace=globals())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr, value=arg)

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.terminate()
            return
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Move_along_trajectory_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
