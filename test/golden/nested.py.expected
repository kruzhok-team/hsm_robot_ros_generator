import sys

import rclpy
from rclpy.executors import ExternalShutdownException
import hsmd
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None
# the event being processed, set by the dispatcher
event = None
# the exit code of a controller stopped by an error of the diagram code
EXIT_DIAGRAM_ERROR = 1


def on_st_outer_middle_inner_enter():
    Debug.println('inner')


def on_st_outer_middle_inner2_enter():
    Debug.println('inner2')


def on_st_outer_sibling_enter():
    Debug.println('sibling')


machine = hsmd.Machine('nested', states=[
    hsmd.Initial(id='initial'),
    hsmd.State('outer', states=[
        hsmd.Initial(id='outer.initial'),
        hsmd.State('middle', id='outer_middle', states=[
            hsmd.Initial(id='outer_middle.initial'),
            hsmd.State('inner', id='outer_middle_inner', entry=on_st_outer_middle_inner_enter),
            hsmd.State('inner2', id='outer_middle_inner2', entry=on_st_outer_middle_inner2_enter),
        ]),
        hsmd.State('sibling', id='outer_sibling', entry=on_st_outer_sibling_enter),
    ]),
], transitions=[
    hsmd.Transition('initial', 'outer', id='e0'),
    hsmd.Transition('outer.initial', 'outer_middle', id='e1'),
    hsmd.Transition('outer_middle.initial', 'outer_middle_inner', id='e2'),
    hsmd.Transition('outer_middle_inner', 'outer_middle_inner2', 'TIMER_TICK', id='e3'),
    hsmd.Transition('outer_middle', 'outer_sibling', 'TIMER_TICK_1S', id='e4'),
])

# the diagram id of every model id the trace reports
ELEMENTS = {
    'e0': 'e0',
    'outer': 'nOuter',
    'e1': 'e1',
    'outer_middle': 'nMiddle',
    'e2': 'e2',
    'outer_middle_inner': 'nInner',
    'outer_middle_inner2': 'nInner2',
    'outer_sibling': 'nSibling',
    'e3': 'e3',
    'e4': 'e4',
}


class Nested_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'nested_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        self.failed = False
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            True,
            False,
            ELEMENTS)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        dispatcher = hsmd.Dispatcher(machine, namespace=globals(), trace=self.trace_hook())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__send, eventstr, value=arg)

    def __send(self, eventstr, **parameters):
        # all the outcomes, the completions the event causes included, for the trace
        self.__dispatcher.post(eventstr, **parameters)
        return self.__dispatcher.run()

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            outcomes = step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.failed = True
            self.trace_step(dispatcher, [], str(e))
            self.terminate()
            return
        self.trace_step(dispatcher, outcomes)
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Nested_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    # a run stopped by an error is not a finished one for whoever started it
    if node.failed:
        sys.exit(EXIT_DIAGRAM_ERROR)


if __name__ == "__main__":
    main()
