import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Nested_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'nested_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            True,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("nested")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        Timer_tick_1s = "TIMER_TICK_1S"
        Timer_tick_1sEvent = pysm.Event(Timer_tick_1s)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent,
            "TIMER_TICK_1S": Timer_tick_1sEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_outer = pysm.StateMachine("outer")
        self.__sm.add_state(st_outer)
        st_outer_middle = pysm.StateMachine("outer_middle")
        st_outer.add_state(st_outer_middle, initial=True)
        st_outer_middle_inner = pysm.State("outer_middle_inner")
        st_outer_middle.add_state(st_outer_middle_inner, initial=True)
        st_outer_middle_inner.handlers = {
            "enter": self.on_st_outer_middle_inner_enter}
        st_outer_middle_inner2 = pysm.State("outer_middle_inner2")
        st_outer_middle.add_state(st_outer_middle_inner2)
        st_outer_middle_inner2.handlers = {
            "enter": self.on_st_outer_middle_inner2_enter}
        st_outer_sibling = pysm.State("outer_sibling")
        st_outer.add_state(st_outer_sibling)
        st_outer_sibling.handlers = {
            "enter": self.on_st_outer_sibling_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_outer, events=["INIT"])
        st_outer_middle.add_transition(st_outer_middle_inner, st_outer_middle_inner2, events=[Timer_tick])
        st_outer.add_transition(st_outer_middle, st_outer_sibling, events=[Timer_tick_1s])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_outer_middle_inner_enter(self, *_):
        Debug.println('inner')

    def on_st_outer_middle_inner2_enter(self, *_):
        Debug.println('inner2')

    def on_st_outer_sibling_enter(self, *_):
        Debug.println('sibling')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Nested_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
