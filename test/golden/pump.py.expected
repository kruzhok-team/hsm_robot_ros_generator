import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.pump_caller
import hsm_controller.timer_caller

Debug = None
Pump = None
Timer = None


class Pump_control_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'pump_control_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Pump', 'Timer'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Pump
        Pump = hsm_controller.pump_caller.Pump
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("pump_control")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_elapsed = "TIMER_ELAPSED"
        Timer_elapsedEvent = pysm.Event(Timer_elapsed)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_ELAPSED": Timer_elapsedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_pump_off = pysm.State("pump_off")
        self.__sm.add_state(st_pump_off)
        st_pump_off.handlers = {
            "enter": self.on_st_pump_off_enter}
        st_pump_on = pysm.State("pump_on")
        self.__sm.add_state(st_pump_on)
        st_pump_on.handlers = {
            "enter": self.on_st_pump_on_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_pump_off, events=["INIT"])
        self.__sm.add_transition(st_pump_off, st_pump_on, events=[Timer_elapsed])
        self.__sm.add_transition(st_pump_on, st_pump_off, events=[Timer_elapsed])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_pump_off_enter(self, *_):
        Pump.turn_off()
        Timer.start(5)

    def on_st_pump_on_enter(self, *_):
        Pump.turn_on()
        Timer.start(5)

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Pump_control_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
