class Right_hand_maze_solver_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'right_hand_maze_solver_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        self.failed = False
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Navigation', 'Wheels', 'Timer'),
            False,
            False,
            False,
            ELEMENTS)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        dispatcher = hsmd.Dispatcher(machine, namespace=globals(), trace=self.trace_hook())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__send, eventstr, value=arg)

    def __send(self, eventstr, **parameters):
        # all the outcomes, the completions the event causes included, for the trace
        self.__dispatcher.post(eventstr, **parameters)
        return self.__dispatcher.run()

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            outcomes = step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.failed = True
            self.trace_step(dispatcher, [], str(e))
            self.terminate()
            return
        self.trace_step(dispatcher, outcomes)
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Right_hand_maze_solver_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    # a run stopped by an error is not a finished one for whoever started it
    if node.failed:
        sys.exit(EXIT_DIAGRAM_ERROR)


if __name__ == "__main__":
    main()
