def on_st_right_hand_maze_solver_solver_right_turn_turn_right_1_enter():
    Debug.println('right_turn entry')
    Wheels.turn_right(math.pi/4)
    Timer.start(5.0)


def on_st_right_hand_maze_solver_solver_right_turn_turn_right_1_exit():
    Wheels.stop()


def on_st_right_hand_maze_solver_solver_left_turn_turn_left_2_enter():
