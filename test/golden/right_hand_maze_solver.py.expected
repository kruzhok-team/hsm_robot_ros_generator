def on_st_right_hand_maze_solver_solver_go_farward_0_exit():
    Wheels.stop()


def on_st_right_hand_maze_solver_solver_right_turn_go_forward_1_enter():
    Wheels.forward(0.3)
    Timer.start(4.0)


def on_st_right_hand_maze_solver_solver_right_turn_go_forward_1_exit():
