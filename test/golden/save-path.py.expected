import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.navigation_caller
import hsm_controller.storage_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Navigation = None
Storage = None
Wheels = None


class Gps_tracker_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'gps_tracker_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Navigation', 'Storage', 'Wheels'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Storage
        Storage = hsm_controller.storage_caller.Storage
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        self.__sm = pysm.StateMachine("gps_tracker")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_elapsed = "TIMER_ELAPSED"
        Timer_elapsedEvent = pysm.Event(Timer_elapsed)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_ELAPSED": Timer_elapsedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_gps_tracker = pysm.StateMachine("gps_tracker")
        self.__sm.add_state(st_gps_tracker)
        st_gps_tracker_save_path = pysm.State("gps_tracker_save_path")
        st_gps_tracker.add_state(st_gps_tracker_save_path, initial=True)
        st_gps_tracker_save_path.handlers = {
            "enter": self.on_st_gps_tracker_save_path_enter}
        # Internal transitions:
        st_gps_tracker.add_transition(
            st_gps_tracker_save_path,
            None,
            events=[Timer_elapsed],
            action=self.on_gps_tracker_save_path_TIMER_ELAPSED)

        # External transitions:
        self.__sm.add_transition(st_initial, st_gps_tracker_save_path, events=["INIT"])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_gps_tracker_save_path_enter(self, *_):
        Timer.start(10, True)
        Debug.println('start')
        Storage.new('path')

    # Transition Conditions and Actions:

    def on_gps_tracker_save_path_TIMER_ELAPSED(self, state, event):
        pnt = Navigation.get_point()
        Debug.print('save point: ')
        Debug.println(str(pnt))
        Storage.add('path', pnt)

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Gps_tracker_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
