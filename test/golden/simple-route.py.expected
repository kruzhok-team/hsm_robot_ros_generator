import sys

import rclpy
from rclpy.executors import ExternalShutdownException
import hsmd
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.navigation_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Navigation = None
Wheels = None
# the event being processed, set by the dispatcher
event = None
# the exit code of a controller stopped by an error of the diagram code
EXIT_DIAGRAM_ERROR = 1


def on_st_pass_labirinth_go_to_point_start_enter():
    Navigation.move_to_point(1, 1)
    Debug.println('start')


def on_st_pass_labirinth_go_to_point_complete_enter():
    Debug.println('finish')


def on_st_pass_labirinth_go_to_point_obstacle_enter():
    Navigation.stop()
    Debug.println('ups')


machine = hsmd.Machine('pass_labirinth', states=[
    hsmd.Initial(id='initial'),
    hsmd.Final(id='final'),
    hsmd.State('pass_labirinth', states=[
        hsmd.Initial(id='pass_labirinth.initial'),
        hsmd.State('go_to_point', id='pass_labirinth_go_to_point', states=[
            hsmd.Initial(id='pass_labirinth_go_to_point.initial'),
            hsmd.State(
                'start',
                id='pass_labirinth_go_to_point_start',
                entry=on_st_pass_labirinth_go_to_point_start_enter),
            hsmd.State(
                'complete',
                id='pass_labirinth_go_to_point_complete',
                entry=on_st_pass_labirinth_go_to_point_complete_enter),
            hsmd.State(
                'obstacle',
                id='pass_labirinth_go_to_point_obstacle',
                entry=on_st_pass_labirinth_go_to_point_obstacle_enter),
        ]),
    ]),
], transitions=[
    hsmd.Transition('initial', 'pass_labirinth_go_to_point_start'),
    hsmd.Transition('pass_labirinth.initial', 'pass_labirinth_go_to_point'),
    hsmd.Transition('pass_labirinth_go_to_point.initial', 'pass_labirinth_go_to_point_start'),
    hsmd.Transition('pass_labirinth_go_to_point_complete', 'final', 'TIMER_TICK'),
    hsmd.Transition('pass_labirinth_go_to_point_start', 'pass_labirinth_go_to_point_complete', 'MOVE_COMPLETED'),
    hsmd.Transition('pass_labirinth_go_to_point_start', 'pass_labirinth_go_to_point_obstacle', 'COLLISION_DETECTED'),
])


class Pass_labirinth_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'pass_labirinth_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        self.failed = False
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Navigation', 'Wheels'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        dispatcher = hsmd.Dispatcher(machine, namespace=globals())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr, value=arg)

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.failed = True
            self.terminate()
            return
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Pass_labirinth_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    # a run stopped by an error is not a finished one for whoever started it
    if node.failed:
        sys.exit(EXIT_DIAGRAM_ERROR)


if __name__ == "__main__":
    main()
