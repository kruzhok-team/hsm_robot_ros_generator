import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.navigation_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Navigation = None
Wheels = None


class Pass_labirinth_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'pass_labirinth_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Navigation', 'Wheels'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        self.__sm = pysm.StateMachine("pass_labirinth")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        Move_completed = "MOVE_COMPLETED"
        Move_completedEvent = pysm.Event(Move_completed)
        Collision_detected = "COLLISION_DETECTED"
        Collision_detectedEvent = pysm.Event(Collision_detected)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK": Timer_tickEvent,
            "MOVE_COMPLETED": Move_completedEvent,
            "COLLISION_DETECTED": Collision_detectedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_terminate = pysm.State("terminate")
        self.__sm.add_state(st_terminate)
        st_terminate.handlers = {"enter": self.terminate}
        st_pass_labirinth = pysm.StateMachine("pass_labirinth")
        self.__sm.add_state(st_pass_labirinth)
        st_pass_labirinth_go_to_point = pysm.StateMachine("pass_labirinth_go_to_point")
        st_pass_labirinth.add_state(st_pass_labirinth_go_to_point, initial=True)
        st_pass_labirinth_go_to_point_start = pysm.State("pass_labirinth_go_to_point_start")
        st_pass_labirinth_go_to_point.add_state(st_pass_labirinth_go_to_point_start, initial=True)
        st_pass_labirinth_go_to_point_start.handlers = {
            "enter": self.on_st_pass_labirinth_go_to_point_start_enter}
        st_pass_labirinth_go_to_point_complete = pysm.State("pass_labirinth_go_to_point_complete")
        st_pass_labirinth_go_to_point.add_state(st_pass_labirinth_go_to_point_complete)
        st_pass_labirinth_go_to_point_complete.handlers = {
            "enter": self.on_st_pass_labirinth_go_to_point_complete_enter}
        st_pass_labirinth_go_to_point_obstacle = pysm.State("pass_labirinth_go_to_point_obstacle")
        st_pass_labirinth_go_to_point.add_state(st_pass_labirinth_go_to_point_obstacle)
        st_pass_labirinth_go_to_point_obstacle.handlers = {
            "enter": self.on_st_pass_labirinth_go_to_point_obstacle_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_pass_labirinth_go_to_point_start, events=["INIT"])
        st_pass_labirinth_go_to_point.add_transition(
            st_pass_labirinth_go_to_point_complete,
            st_terminate,
            events=[Timer_tick])
        st_pass_labirinth_go_to_point.add_transition(
            st_pass_labirinth_go_to_point_start,
            st_pass_labirinth_go_to_point_complete,
            events=[Move_completed])
        st_pass_labirinth_go_to_point.add_transition(
            st_pass_labirinth_go_to_point_start,
            st_pass_labirinth_go_to_point_obstacle,
            events=[Collision_detected])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_pass_labirinth_go_to_point_start_enter(self, *_):
        Navigation.move_to_point(1, 1)
        Debug.println('start')

    def on_st_pass_labirinth_go_to_point_complete_enter(self, *_):
        Debug.println('finish')

    def on_st_pass_labirinth_go_to_point_obstacle_enter(self, *_):
        Navigation.stop()
        Debug.println('ups')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Pass_labirinth_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
