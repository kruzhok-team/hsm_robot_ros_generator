import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.storage_caller
import hsm_controller.timer_caller

Debug = None
Storage = None
Timer = None


class Storage_reader_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'storage_reader_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Storage', 'Timer'),
            True,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Storage
        Storage = hsm_controller.storage_caller.Storage
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("storage_reader")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_elapsed = "TIMER_ELAPSED"
        Timer_elapsedEvent = pysm.Event(Timer_elapsed)
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_ELAPSED": Timer_elapsedEvent,
            "TIMER_TICK": Timer_tickEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_load = pysm.State("load")
        self.__sm.add_state(st_load)
        st_load.handlers = {
            "enter": self.on_st_load_enter}
        st_read = pysm.State("read")
        self.__sm.add_state(st_read)
        st_read.handlers = {
            "enter": self.on_st_read_enter}
        st_done = pysm.State("done")
        self.__sm.add_state(st_done)
        st_done.handlers = {
            "enter": self.on_st_done_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_load, events=["INIT"])
        self.__sm.add_transition(st_load, st_read, events=[Timer_elapsed])
        self.__sm.add_transition(st_read, st_read, events=[Timer_tick], condition=self.is_read_TO_read_TIMER_TICK)
        self.__sm.add_transition(st_read, st_done, events=[Timer_tick], condition=self.is_read_TO_done_TIMER_TICK)
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_load_enter(self, *_):
        Storage.load('path')
        Timer.start(1)

    def on_st_read_enter(self, *_):
        pnt = Storage.next('path')
        Debug.println(str(pnt))

    def on_st_done_enter(self, *_):
        Debug.println('done')

    # Transition Conditions and Actions:

    def is_read_TO_read_TIMER_TICK(self, state, event):
        return (Storage.has_data('path'))

    def is_read_TO_done_TIMER_TICK(self, state, event):
        return (not Storage.has_data('path'))

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Storage_reader_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
