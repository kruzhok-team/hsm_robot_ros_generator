import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Timer_elapsed_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'timer_elapsed_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("timer_elapsed")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_elapsed = "TIMER_ELAPSED"
        Timer_elapsedEvent = pysm.Event(Timer_elapsed)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_ELAPSED": Timer_elapsedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_waiting = pysm.State("waiting")
        self.__sm.add_state(st_waiting)
        st_waiting.handlers = {
            "enter": self.on_st_waiting_enter}
        st_awake = pysm.State("awake")
        self.__sm.add_state(st_awake)
        st_awake.handlers = {
            "enter": self.on_st_awake_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_waiting, events=["INIT"])
        self.__sm.add_transition(
            st_waiting,
            st_awake,
            events=[Timer_elapsed],
            action=self.on_waiting_TO_awake_TIMER_ELAPSED)
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_waiting_enter(self, *_):
        Timer.start(3, False, 'wakeup')

    def on_st_awake_enter(self, *_):
        Debug.println('awake')

    # Transition Conditions and Actions:

    def on_waiting_TO_awake_TIMER_ELAPSED(self, state, event):
        name = event.cargo["value"]
        Debug.println(name)

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Timer_elapsed_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
