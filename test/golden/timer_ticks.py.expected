import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller

Debug = None
Timer = None


class Timer_ticks_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'timer_ticks_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer'),
            True,
            True,
            True)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer

        self.__sm = pysm.StateMachine("timer_ticks")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_tick_1s = "TIMER_TICK_1S"
        Timer_tick_1sEvent = pysm.Event(Timer_tick_1s)
        Timer_tick_1m = "TIMER_TICK_1M"
        Timer_tick_1mEvent = pysm.Event(Timer_tick_1m)
        Timer_tick = "TIMER_TICK"
        Timer_tickEvent = pysm.Event(Timer_tick)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_TICK_1S": Timer_tick_1sEvent,
            "TIMER_TICK_1M": Timer_tick_1mEvent,
            "TIMER_TICK": Timer_tickEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_tick = pysm.State("tick")
        self.__sm.add_state(st_tick)
        st_tick.handlers = {
            "enter": self.on_st_tick_enter}
        st_second = pysm.State("second")
        self.__sm.add_state(st_second)
        st_second.handlers = {
            "enter": self.on_st_second_enter}
        st_minute = pysm.State("minute")
        self.__sm.add_state(st_minute)
        st_minute.handlers = {
            "enter": self.on_st_minute_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_tick, events=["INIT"])
        self.__sm.add_transition(st_tick, st_second, events=[Timer_tick_1s])
        self.__sm.add_transition(st_second, st_minute, events=[Timer_tick_1m])
        self.__sm.add_transition(st_minute, st_tick, events=[Timer_tick])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_tick_enter(self, *_):
        Debug.println('tick')

    def on_st_second_enter(self, *_):
        Debug.println('second')

    def on_st_minute_enter(self, *_):
        Debug.println('minute')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Timer_ticks_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
