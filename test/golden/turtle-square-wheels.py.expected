import rclpy
from rclpy.executors import ExternalShutdownException
import hsmd
import math
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Wheels = None
# the event being processed, set by the dispatcher
event = None


def on_st_turtle_square_wheels_go_by_square_turn_right_enter():
    # PI/2 per 5 sec
    Wheels.turn_right((math.pi/2)/5)
    Timer.start(5.0)


def on_st_turtle_square_wheels_go_by_square_turn_right_exit():
    Wheels.stop()


def on_st_turtle_square_wheels_go_by_square_go_ahead_enter():
    # 1 meter per sec
    Wheels.forward(1.0)
    Timer.start(4.0)


def on_st_turtle_square_wheels_go_by_square_go_ahead_exit():
    Wheels.stop()


machine = hsmd.Machine('turtle_square_wheels', states=[
    hsmd.Initial(id='initial'),
    hsmd.State('turtle_square_wheels', states=[
        hsmd.Initial(id='turtle_square_wheels.initial'),
        hsmd.State('go_by_square', id='turtle_square_wheels_go_by_square', states=[
            hsmd.Initial(id='turtle_square_wheels_go_by_square.initial'),
            hsmd.State(
                'turn_right',
                id='turtle_square_wheels_go_by_square_turn_right',
                entry=on_st_turtle_square_wheels_go_by_square_turn_right_enter,
                exit=on_st_turtle_square_wheels_go_by_square_turn_right_exit),
            hsmd.State(
                'go_ahead',
                id='turtle_square_wheels_go_by_square_go_ahead',
                entry=on_st_turtle_square_wheels_go_by_square_go_ahead_enter,
                exit=on_st_turtle_square_wheels_go_by_square_go_ahead_exit),
        ]),
    ]),
], transitions=[
    hsmd.Transition('initial', 'turtle_square_wheels_go_by_square_turn_right'),
    hsmd.Transition('turtle_square_wheels.initial', 'turtle_square_wheels_go_by_square'),
    hsmd.Transition('turtle_square_wheels_go_by_square.initial', 'turtle_square_wheels_go_by_square_turn_right'),
    hsmd.Transition(
        'turtle_square_wheels_go_by_square_turn_right',
        'turtle_square_wheels_go_by_square_go_ahead',
        'TIMER_ELAPSED'),
    hsmd.Transition(
        'turtle_square_wheels_go_by_square_go_ahead',
        'turtle_square_wheels_go_by_square_turn_right',
        'TIMER_ELAPSED'),
])


class Turtle_square_wheels_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'turtle_square_wheels_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Wheels'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        dispatcher = hsmd.Dispatcher(machine, namespace=globals())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr, value=arg)

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.terminate()
            return
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Turtle_square_wheels_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
