import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import math
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.timer_caller
import hsm_controller.wheels_caller

Debug = None
Timer = None
Wheels = None


class Turtle_square_wheels_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'turtle_square_wheels_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Timer', 'Wheels'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Timer
        Timer = hsm_controller.timer_caller.Timer
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        self.__sm = pysm.StateMachine("turtle_square_wheels")
        # Events:

        InitEvent = pysm.Event("INIT")
        Timer_elapsed = "TIMER_ELAPSED"
        Timer_elapsedEvent = pysm.Event(Timer_elapsed)
        self.__events = {
            "INIT": InitEvent,
            "TIMER_ELAPSED": Timer_elapsedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_turtle_square_wheels = pysm.StateMachine("turtle_square_wheels")
        self.__sm.add_state(st_turtle_square_wheels)
        st_turtle_square_wheels_go_by_square = pysm.StateMachine("turtle_square_wheels_go_by_square")
        st_turtle_square_wheels.add_state(st_turtle_square_wheels_go_by_square, initial=True)
        st_turtle_square_wheels_go_by_square_turn_right = pysm.State("turtle_square_wheels_go_by_square_turn_right")
        st_turtle_square_wheels_go_by_square.add_state(st_turtle_square_wheels_go_by_square_turn_right, initial=True)
        st_turtle_square_wheels_go_by_square_turn_right.handlers = {
            "enter": self.on_st_turtle_square_wheels_go_by_square_turn_right_enter,
            "exit": self.on_st_turtle_square_wheels_go_by_square_turn_right_exit}
        st_turtle_square_wheels_go_by_square_go_ahead = pysm.State("turtle_square_wheels_go_by_square_go_ahead")
        st_turtle_square_wheels_go_by_square.add_state(st_turtle_square_wheels_go_by_square_go_ahead)
        st_turtle_square_wheels_go_by_square_go_ahead.handlers = {
            "enter": self.on_st_turtle_square_wheels_go_by_square_go_ahead_enter,
            "exit": self.on_st_turtle_square_wheels_go_by_square_go_ahead_exit}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_turtle_square_wheels_go_by_square_turn_right, events=["INIT"])
        st_turtle_square_wheels_go_by_square.add_transition(
            st_turtle_square_wheels_go_by_square_turn_right,
            st_turtle_square_wheels_go_by_square_go_ahead,
            events=[Timer_elapsed])
        st_turtle_square_wheels_go_by_square.add_transition(
            st_turtle_square_wheels_go_by_square_go_ahead,
            st_turtle_square_wheels_go_by_square_turn_right,
            events=[Timer_elapsed])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_turtle_square_wheels_go_by_square_turn_right_enter(self, *_):
        # PI/2 per 5 sec
        Wheels.turn_right((math.pi/2)/5)
        Timer.start(5.0)

    def on_st_turtle_square_wheels_go_by_square_turn_right_exit(self, *_):
        Wheels.stop()

    def on_st_turtle_square_wheels_go_by_square_go_ahead_enter(self, *_):
        # 1 meter per sec
        Wheels.forward(1.0)
        Timer.start(4.0)

    def on_st_turtle_square_wheels_go_by_square_go_ahead_exit(self, *_):
        Wheels.stop()

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Turtle_square_wheels_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
