import rclpy
from rclpy.executors import ExternalShutdownException
import pysm
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.navigation_caller
import hsm_controller.wheels_caller

Debug = None
Navigation = None
Wheels = None


class Turtle_square_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'turtle_square_hsm_controller'

    def __init__(self):
        self.__events = {}
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Navigation', 'Wheels'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        self.__sm = pysm.StateMachine("turtle_square")
        # Events:

        InitEvent = pysm.Event("INIT")
        Move_completed = "MOVE_COMPLETED"
        Move_completedEvent = pysm.Event(Move_completed)
        self.__events = {
            "INIT": InitEvent,
            "MOVE_COMPLETED": Move_completedEvent}
        # Hierarchical States:
        st_initial = pysm.State("initial")
        self.__sm.add_state(st_initial, initial=True)
        st_turtle_square = pysm.StateMachine("turtle_square")
        self.__sm.add_state(st_turtle_square)
        st_turtle_square_four_corners = pysm.StateMachine("turtle_square_four_corners")
        st_turtle_square.add_state(st_turtle_square_four_corners, initial=True)
        st_turtle_square_four_corners_top_left = pysm.State("turtle_square_four_corners_top_left")
        st_turtle_square_four_corners.add_state(st_turtle_square_four_corners_top_left, initial=True)
        st_turtle_square_four_corners_top_left.handlers = {
            "enter": self.on_st_turtle_square_four_corners_top_left_enter}
        st_turtle_square_four_corners_top_right = pysm.State("turtle_square_four_corners_top_right")
        st_turtle_square_four_corners.add_state(st_turtle_square_four_corners_top_right)
        st_turtle_square_four_corners_top_right.handlers = {
            "enter": self.on_st_turtle_square_four_corners_top_right_enter}
        st_turtle_square_four_corners_bottom_right = pysm.State("turtle_square_four_corners_bottom_right")
        st_turtle_square_four_corners.add_state(st_turtle_square_four_corners_bottom_right)
        st_turtle_square_four_corners_bottom_right.handlers = {
            "enter": self.on_st_turtle_square_four_corners_bottom_right_enter}
        st_turtle_square_four_corners_bottom_left = pysm.State("turtle_square_four_corners_bottom_left")
        st_turtle_square_four_corners.add_state(st_turtle_square_four_corners_bottom_left)
        st_turtle_square_four_corners_bottom_left.handlers = {
            "enter": self.on_st_turtle_square_four_corners_bottom_left_enter}
        # Internal transitions:

        # External transitions:
        self.__sm.add_transition(st_initial, st_turtle_square_four_corners_top_left, events=["INIT"])
        st_turtle_square_four_corners.add_transition(
            st_turtle_square_four_corners_top_left,
            st_turtle_square_four_corners_top_right,
            events=[Move_completed])
        st_turtle_square_four_corners.add_transition(
            st_turtle_square_four_corners_top_right,
            st_turtle_square_four_corners_bottom_right,
            events=[Move_completed])
        st_turtle_square_four_corners.add_transition(
            st_turtle_square_four_corners_bottom_right,
            st_turtle_square_four_corners_bottom_left,
            events=[Move_completed])
        st_turtle_square_four_corners.add_transition(
            st_turtle_square_four_corners_bottom_left,
            st_turtle_square_four_corners_top_left,
            events=[Move_completed])
        self.__sm.initialize()
        self.__sm.dispatch(InitEvent)
    # Entry & Exit Handlers:

    def on_st_turtle_square_four_corners_top_left_enter(self, *_):
        Navigation.move_to_point(2, 7)
        Debug.println('go to top-left')

    def on_st_turtle_square_four_corners_top_right_enter(self, *_):
        Navigation.move_to_point(7, 7)
        Debug.println('go to top-right')

    def on_st_turtle_square_four_corners_bottom_right_enter(self, *_):
        Navigation.move_to_point(7, 2)
        Debug.println('go to bottom-right')

    def on_st_turtle_square_four_corners_bottom_left_enter(self, *_):
        Navigation.move_to_point(2, 2)
        Debug.println('go to bottom-left')

    # Transition Conditions and Actions:

    def dispatch_event(self, eventstr, arg):
        if eventstr is not None and eventstr in self.__events:
            if arg is None:
                self.__sm.dispatch(pysm.Event(eventstr))
            else:
                args = {"value": arg}
                self.__sm.dispatch(pysm.Event(eventstr, **args))


def main(args=None):
    rclpy.init(args=args)
    node = Turtle_square_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
