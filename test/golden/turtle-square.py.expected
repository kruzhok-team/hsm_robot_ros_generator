import sys

import rclpy
from rclpy.executors import ExternalShutdownException
import hsmd
import hsm_controller.base_hsm_controller
import hsm_controller.debug_caller
import hsm_controller.navigation_caller
import hsm_controller.wheels_caller

Debug = None
Navigation = None
Wheels = None
# the event being processed, set by the dispatcher
event = None
# the exit code of a controller stopped by an error of the diagram code
EXIT_DIAGRAM_ERROR = 1


def on_st_turtle_square_four_corners_top_left_enter():
    Navigation.move_to_point(2, 7)
    Debug.println('go to top-left')


def on_st_turtle_square_four_corners_top_right_enter():
    Navigation.move_to_point(7, 7)
    Debug.println('go to top-right')


def on_st_turtle_square_four_corners_bottom_right_enter():
    Navigation.move_to_point(7, 2)
    Debug.println('go to bottom-right')


def on_st_turtle_square_four_corners_bottom_left_enter():
    Navigation.move_to_point(2, 2)
    Debug.println('go to bottom-left')


machine = hsmd.Machine('turtle_square', states=[
    hsmd.Initial(id='initial'),
    hsmd.State('turtle_square', states=[
        hsmd.Initial(id='turtle_square.initial'),
        hsmd.State('four_corners', id='turtle_square_four_corners', states=[
            hsmd.Initial(id='turtle_square_four_corners.initial'),
            hsmd.State(
                'top-left',
                id='turtle_square_four_corners_top_left',
                entry=on_st_turtle_square_four_corners_top_left_enter),
            hsmd.State(
                'top-right',
                id='turtle_square_four_corners_top_right',
                entry=on_st_turtle_square_four_corners_top_right_enter),
            hsmd.State(
                'bottom-right',
                id='turtle_square_four_corners_bottom_right',
                entry=on_st_turtle_square_four_corners_bottom_right_enter),
            hsmd.State(
                'bottom-left',
                id='turtle_square_four_corners_bottom_left',
                entry=on_st_turtle_square_four_corners_bottom_left_enter),
        ]),
    ]),
], transitions=[
    hsmd.Transition('initial', 'turtle_square_four_corners_top_left'),
    hsmd.Transition('turtle_square.initial', 'turtle_square_four_corners'),
    hsmd.Transition('turtle_square_four_corners.initial', 'turtle_square_four_corners_top_left'),
    hsmd.Transition('turtle_square_four_corners_top_left', 'turtle_square_four_corners_top_right', 'MOVE_COMPLETED'),
    hsmd.Transition(
        'turtle_square_four_corners_top_right',
        'turtle_square_four_corners_bottom_right',
        'MOVE_COMPLETED'),
    hsmd.Transition(
        'turtle_square_four_corners_bottom_right',
        'turtle_square_four_corners_bottom_left',
        'MOVE_COMPLETED'),
    hsmd.Transition('turtle_square_four_corners_bottom_left', 'turtle_square_four_corners_top_left', 'MOVE_COMPLETED'),
])


class Turtle_square_HSMController(hsm_controller.base_hsm_controller.BaseHSMController):

    OBJECT_NAME = 'turtle_square_hsm_controller'

    def __init__(self):
        # the base controller may process the messages while it waits for the services
        self.__dispatcher = None
        self.failed = False
        hsm_controller.base_hsm_controller.BaseHSMController.__init__(
            self,
            self.OBJECT_NAME,
            ('Debug', 'Navigation', 'Wheels'),
            False,
            False,
            False)
        global Debug
        Debug = hsm_controller.debug_caller.Debug
        global Navigation
        Navigation = hsm_controller.navigation_caller.Navigation
        global Wheels
        Wheels = hsm_controller.wheels_caller.Wheels

        dispatcher = hsmd.Dispatcher(machine, namespace=globals())
        self.__run(dispatcher, dispatcher.start)
        self.__dispatcher = dispatcher

    def dispatch_event(self, eventstr, arg):
        if eventstr is None or self.__dispatcher is None:
            return
        if arg is None:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr)
        else:
            self.__run(self.__dispatcher, self.__dispatcher.send, eventstr, value=arg)

    def __run(self, dispatcher, step, *args, **parameters):
        # an error of the diagram code stops the dispatcher, and so the controller
        try:
            step(*args, **parameters)
        except hsmd.DispatcherError as e:
            self.get_logger().error('The state machine is stopped: {}'.format(e))
            self.failed = True
            self.terminate()
            return
        if dispatcher.finished():
            self.terminate()


def main(args=None):
    rclpy.init(args=args)
    node = Turtle_square_HSMController()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    # a run stopped by an error is not a finished one for whoever started it
    if node.failed:
        sys.exit(EXIT_DIAGRAM_ERROR)


if __name__ == "__main__":
    main()
